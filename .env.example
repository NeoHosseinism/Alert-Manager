# ============================================
# ENVIRONMENT
# ============================================
# Options: dev, stage, prod
# - dev: Uses sandbox bot, DEBUG logging, shows full errors
# - stage: Uses main bot, INFO logging, limited error messages
# - prod: Uses main bot, INFO logging, minimal error messages
ENVIRONMENT=prod

# Enable debug mode (verbose logging)
DEBUG=false

# ============================================
# DATABASE - Multi-parameter configuration
# ============================================
# Database connection parameters (will be auto-constructed into URL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=alert_manager_db
DATABASE_USER=alert_manager_user
DATABASE_PASSWORD=secure_password

# Database driver (asyncpg recommended for async, psycopg2 for sync)
DATABASE_DRIVER=asyncpg

# Connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# ============================================
# TELEGRAM BOTS
# ============================================
# IMPORTANT: These are EXAMPLE tokens. You MUST:
# 1. Create your own bot(s) by messaging @BotFather on Telegram
# 2. Replace these values with your actual bot tokens
# 3. The app will fail to start with invalid tokens

# Main bot (used in stage and prod environments)
TELEGRAM_MAIN_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_MAIN_BOT_USERNAME=ProductionMonitorBot

# Sandbox bot (used in dev environment for testing)
TELEGRAM_SANDBOX_BOT_TOKEN=9876543210:XYZabcDEFghiJKLmnoPQRstuVWX
TELEGRAM_SANDBOX_BOT_USERNAME=SandboxMonitorBot

# ============================================
# ENCRYPTION
# ============================================
# Fernet key for encrypting API keys in database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-base64-encoded-fernet-key-here

# ============================================
# MONITORING DEFAULTS
# ============================================
# Default interval for health checks (seconds)
DEFAULT_HEALTH_CHECK_INTERVAL=300

# Default timeout for HTTP requests (seconds)
DEFAULT_HEALTH_CHECK_TIMEOUT=10

# Number of retries before alerting
DEFAULT_MAX_RETRIES=3

# Delay between retries (seconds)
DEFAULT_RETRY_DELAY=30

# ============================================
# ALERT SETTINGS
# ============================================
# Time window for aggregating alerts (seconds)
# Multiple failures within this window will be grouped into one message
ALERT_AGGREGATION_WINDOW=120

# Minimum time between same alerts (minutes)
# Prevents alert spam
ALERT_COOLDOWN_MINUTES=30

# Flush batch after N alerts total
ALERT_BATCH_FLUSH_COUNT=10

# Flush critical alerts after N critical alerts
ALERT_CRITICAL_BATCH_COUNT=5

# ============================================
# API CREDIT MONITORING (Generic)
# ============================================
# Default credit threshold (alert when remaining credits below this amount)
DEFAULT_CREDIT_THRESHOLD=20.00

# Default credit check interval (hours)
DEFAULT_CREDIT_CHECK_INTERVAL=24

# ============================================
# REPORTING
# ============================================
# Chart quality (DPI)
REPORT_CHART_DPI=150

# Matplotlib style
REPORT_CHART_STYLE=seaborn-v0_8-whitegrid

# Font family for charts
REPORT_FONT_FAMILY=DejaVu Sans

# Hour to send reports (0-23, in UTC)
REPORT_TIME_HOUR=9

# Enable/disable report types
ENABLE_DAILY_REPORTS=true
ENABLE_WEEKLY_REPORTS=true
ENABLE_MONTHLY_REPORTS=true

# ============================================
# LOGGING
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: json (for production) or console (for development)
LOG_FORMAT=json

# ============================================
# ARCHIVING
# ============================================
# Default days to keep alerts before archiving
DEFAULT_ARCHIVE_AFTER_DAYS=365

# ============================================
# SCHEDULER
# ============================================
# Timezone for scheduler (use UTC for consistency)
SCHEDULER_TIMEZONE=UTC

# ============================================
# EXAMPLE PRODUCTION CONFIGURATION
# ============================================
# For a production setup, your configuration might look like:
#
# ENVIRONMENT=prod
# DEBUG=false
# DATABASE_URL=postgresql+asyncpg://monitor_prod:strong_password@db.example.com:5432/monitoring_prod
# TELEGRAM_MAIN_BOT_TOKEN=<your-production-bot-token>
# TELEGRAM_MAIN_BOT_USERNAME=MyCompanyMonitorBot
# ENCRYPTION_KEY=<your-generated-fernet-key>
# LOG_LEVEL=INFO
# LOG_FORMAT=json
